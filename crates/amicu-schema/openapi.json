{
  "openapi": "3.1.0",
  "info": {
    "title": "Amicu Management API",
    "description": "First-party auth plus the stateless validate/plan engine endpoints.",
    "license": {
      "name": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "jwks",
        "responses": {
          "200": {
            "description": "JSON Web Key Set: the issuer's public verification keys."
          }
        }
      }
    },
    "/.well-known/openid-configuration": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "openid_configuration",
        "responses": {
          "200": {
            "description": "OpenID Connect discovery document."
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Refresh token revoked (idempotent)."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/plan": {
      "post": {
        "tags": [
          "engine"
        ],
        "summary": "Plan a submitted configuration.",
        "description": "Parses the HCL (and optional prior-state HCL), surfaces structural errors\nthrough the same diagnostic path as `/validate`, then diffs into the [`Plan`]\ncontract. When the config cannot be planned (structural errors, or\nadapter-level validation errors) the response is `422` carrying the blocking\n[`DiagnosticReport`]. Stateless and side-effect-free: no plan is applied.",
        "operationId": "plan_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The computed plan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "400": {
            "description": "The config (or prior) text is not valid Amicu HCL."
          },
          "401": {
            "description": "Missing or invalid access token."
          },
          "403": {
            "description": "Access tier insufficient."
          },
          "422": {
            "description": "The config is invalid and cannot be planned; body is a DiagnosticReport.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticReport"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/recommend": {
      "post": {
        "tags": [
          "recommend"
        ],
        "summary": "Diagnose a stack and return advisory recommendations.",
        "description": "Runs the advisory rule engine over the submitted measured metrics and the\nworkload estimate, then returns the [`TuningReport`] *for the caller's tier*:\nrecommendations the caller has not unlocked are withheld (a Community token\ngets `200` with an empty list, Pro+ gets the full depth). Stateless and\nside-effect-free: nothing is applied — recommendations are advisory data.",
        "operationId": "recommend_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The tier-appropriate advisory tuning report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TuningReportDto"
                }
              }
            }
          },
          "400": {
            "description": "The request body is malformed."
          },
          "401": {
            "description": "Missing or invalid access token."
          },
          "403": {
            "description": "Access tier insufficient to reach the endpoint."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/recover": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Request a password reset.",
        "description": "Anti-enumeration: this ALWAYS returns the same generic `202 Accepted`,\nwhether or not the email is registered, with no account-existence signal in\nthe body or (Argon2 runs on neither path) the timing. A reset token is minted\nand delivered out-of-band via the notification seam only when the account\nexists. Mirrors the identical-response defense on `/signup`.",
        "operationId": "recover",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoverRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted. If the email is registered, a reset link is sent out-of-band. Response is identical whether or not the account exists (anti-enumeration).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoverResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/reset": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Complete a password reset: consume a valid reset token and install a new\npassword.",
        "description": "On success the password hash is replaced and every refresh-token family the\nuser holds is revoked, forcing a fresh sign-in on all devices.\n\nBoth failure modes return `400`, but they are deliberately *not* the same\nmessage: a weak new password gets a distinct, helpful policy message, while\nan unknown/expired/already-used token gets a generic one. This leaks nothing,\nbecause the password policy is checked *before* the token is looked up — so\nthe weak-password message can never depend on (and never signals) whether the\ntoken is valid or which account it belongs to.",
        "operationId": "reset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password reset: the new password is installed and all prior sessions (refresh families) are revoked."
          },
          "400": {
            "description": "Either the new password fails policy (distinct, helpful message) or the reset token is unknown, expired, or already used (generic message). Policy is checked before token lookup, so neither message reveals token validity or account existence."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/signup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Anti-enumeration: both a brand-new registration and a hit on an existing\naccount return the *same* generic `202 Accepted` body, with the same Argon2\ntiming (the service hashes on both paths). Only request-level validation\n(empty email / weak password) yields a distinguishable error, and that\nreveals nothing about which accounts exist. Mirrors the identical-response\ndefense on `/signin`.",
        "operationId": "sign_up",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted. If the email can be registered, a follow-up is sent out-of-band. Response is identical whether or not the account already exists (anti-enumeration).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignUpResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request-level validation failed (empty email or weak password)."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/token": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Authenticated: an access + refresh token pair.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/token/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Rotated: a fresh access + refresh token pair.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token unknown, expired, or revoked."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/validate": {
      "post": {
        "tags": [
          "engine"
        ],
        "summary": "Validate a submitted configuration.",
        "description": "Parses the HCL and runs structural + per-deployment validation, returning the\n[`DiagnosticReport`] contract. A config that parses but fails validation\nstill returns `200` with `valid: false`; only a parse error is a `400`.",
        "operationId": "validate_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Diagnostic report for the submitted config (may contain errors).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticReport"
                }
              }
            }
          },
          "400": {
            "description": "The config text is not valid Amicu HCL."
          },
          "401": {
            "description": "Missing or invalid access token."
          },
          "403": {
            "description": "Access tier insufficient."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ActionKind": {
        "type": "string",
        "description": "The kind of change a [`PlannedAction`] represents.",
        "enum": [
          "create",
          "update",
          "replace",
          "destroy"
        ]
      },
      "Artifact": {
        "type": "object",
        "description": "A selected model artifact and its download characteristics.",
        "required": [
          "name"
        ],
        "properties": {
          "estimated_download_size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Estimated download size in bytes.",
            "minimum": 0
          },
          "format": {
            "type": [
              "string",
              "null"
            ],
            "description": "Artifact format (e.g. `gguf`, `safetensors`)."
          },
          "name": {
            "type": "string",
            "description": "Artifact name / identifier."
          },
          "quantization": {
            "type": [
              "string",
              "null"
            ],
            "description": "Quantization label (e.g. `Q4_K_M`), if quantized."
          }
        }
      },
      "AssumptionDto": {
        "type": "object",
        "description": "A single stated assumption a diagnosis depends on.",
        "required": [
          "statement"
        ],
        "properties": {
          "statement": {
            "type": "string"
          }
        }
      },
      "BottleneckClassDto": {
        "type": "string",
        "description": "The class of bottleneck a diagnosis assigns. Mirrors\n[`amicu_recommend::BottleneckClass`].",
        "enum": [
          "under_provisioned",
          "over_provisioned",
          "prefill_bound",
          "decode_bound",
          "preemption_recompute"
        ]
      },
      "ChangeDirectionDto": {
        "type": "string",
        "description": "Direction of a suggested change. Mirrors\n[`amicu_recommend::ChangeDirection`].",
        "enum": [
          "increase",
          "decrease",
          "enable",
          "replace"
        ]
      },
      "ComparisonDto": {
        "type": "string",
        "description": "Whether a measured metric sits above or below its threshold. Mirrors\n[`amicu_recommend::Comparison`].",
        "enum": [
          "above",
          "below"
        ]
      },
      "ConcurrencyMetricsDto": {
        "type": "object",
        "description": "Concurrency & batching surface.",
        "required": [
          "in_flight_requests",
          "running_batch_size",
          "max_num_seqs",
          "seq_saturation"
        ],
        "properties": {
          "in_flight_requests": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "max_num_seqs": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "running_batch_size": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "seq_saturation": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Confidence": {
        "type": "string",
        "description": "Confidence level attached to an estimate.",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "ConfidenceDto": {
        "type": "string",
        "description": "How much an estimate or diagnosis can be relied on. Mirrors\n[`amicu_core::estimate::Confidence`].",
        "enum": [
          "high",
          "medium",
          "low",
          "estimated"
        ]
      },
      "CostMetricsDto": {
        "type": "object",
        "description": "Cost surface, including utilization-adjusted idle burn.",
        "required": [
          "per_hour",
          "per_million_tokens",
          "per_request",
          "utilization_adjusted_per_hour"
        ],
        "properties": {
          "per_hour": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "per_million_tokens": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "per_request": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "utilization_adjusted_per_hour": {
            "$ref": "#/components/schemas/MoneyDto"
          }
        }
      },
      "CostPerformance": {
        "type": "object",
        "description": "Estimated cost and performance, with the basis for the estimate.",
        "properties": {
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Assumptions the estimate rests on."
          },
          "confidence": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Confidence",
                "description": "Confidence in the estimate."
              }
            ]
          },
          "cost": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Range",
                "description": "Estimated cost range."
              }
            ]
          },
          "performance": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Range",
                "description": "Estimated performance range (units described in `assumptions`)."
              }
            ]
          },
          "provenance": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the estimate came from (e.g. `benchmark`, `heuristic`)."
          }
        }
      },
      "Credentials": {
        "type": "object",
        "description": "Email + password credentials for sign-up and sign-in.",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "Account email."
          },
          "password": {
            "type": "string",
            "description": "Account password."
          }
        }
      },
      "Diagnostic": {
        "type": "object",
        "description": "A single diagnostic in a [`DiagnosticReport`].",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The standardized diagnostic code.\n\nSerialized as the `AMICU-<CATEGORY>-<NNN>` string form.",
            "example": "AMICU-CAP-001"
          },
          "message": {
            "type": "string",
            "description": "Human-readable message."
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "description": "The attribute path within the resource, if any."
          },
          "resource": {
            "type": [
              "string",
              "null"
            ],
            "description": "The resource address this diagnostic applies to, if any."
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "description": "Severity of this diagnostic."
          },
          "source": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SourceLocation",
                "description": "Source location, if the diagnostic maps to a specific location."
              }
            ]
          },
          "suggested_fixes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SuggestedFix"
            },
            "description": "Suggested fixes; omitted from output when empty."
          }
        }
      },
      "DiagnosticReport": {
        "type": "object",
        "description": "The top-level diagnostic report emitted by `--output json`.",
        "required": [
          "version",
          "valid",
          "diagnostics"
        ],
        "properties": {
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "description": "The diagnostics, in report order."
          },
          "valid": {
            "type": "boolean",
            "description": "Whether the analyzed input is valid (no error-severity diagnostics)."
          },
          "version": {
            "type": "string",
            "description": "Contract version. Currently always `\"v1\"`."
          }
        }
      },
      "DistributionDto": {
        "type": "object",
        "description": "A quantity summarized by percentiles (P50/P90/P99).",
        "required": [
          "p50",
          "p90",
          "p99"
        ],
        "properties": {
          "p50": {
            "type": "number",
            "format": "double"
          },
          "p90": {
            "type": "number",
            "format": "double"
          },
          "p99": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "EstimateRangeDto": {
        "type": "object",
        "description": "An estimate range with the provenance and confidence behind it.",
        "required": [
          "low",
          "high",
          "provenance",
          "confidence"
        ],
        "properties": {
          "confidence": {
            "$ref": "#/components/schemas/ConfidenceDto"
          },
          "high": {
            "type": "number",
            "format": "double"
          },
          "low": {
            "type": "number",
            "format": "double"
          },
          "provenance": {
            "$ref": "#/components/schemas/ProvenanceDto"
          }
        }
      },
      "EvidenceDto": {
        "type": "object",
        "description": "A measured metric that triggered a recommendation, with its threshold.",
        "required": [
          "metric",
          "observed",
          "threshold",
          "comparison"
        ],
        "properties": {
          "comparison": {
            "$ref": "#/components/schemas/ComparisonDto"
          },
          "metric": {
            "type": "string"
          },
          "observed": {
            "type": "number",
            "format": "double"
          },
          "threshold": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "GpuMetricsDto": {
        "type": "object",
        "description": "GPU surface. `vram_used` is a byte-size string, e.g. `\"40GiB\"` or `\"0B\"`.",
        "required": [
          "sm_utilization",
          "vram_used",
          "power_watts"
        ],
        "properties": {
          "power_watts": {
            "type": "number",
            "format": "double"
          },
          "sm_utilization": {
            "type": "number",
            "format": "double"
          },
          "vram_used": {
            "type": "string",
            "example": "40GiB"
          }
        }
      },
      "LatencyMetricsDto": {
        "type": "object",
        "description": "Latency surface: TTFT, TPOT, end-to-end (ms), each a percentile distribution.",
        "required": [
          "ttft_ms",
          "tpot_ms",
          "e2e_ms"
        ],
        "properties": {
          "e2e_ms": {
            "$ref": "#/components/schemas/DistributionDto"
          },
          "tpot_ms": {
            "$ref": "#/components/schemas/DistributionDto"
          },
          "ttft_ms": {
            "$ref": "#/components/schemas/DistributionDto"
          }
        }
      },
      "MemoryKvMetricsDto": {
        "type": "object",
        "description": "Memory / KV-cache surface.",
        "required": [
          "kv_cache_utilization",
          "preemptions",
          "recomputations",
          "oom_events"
        ],
        "properties": {
          "kv_cache_utilization": {
            "type": "number",
            "format": "double"
          },
          "oom_events": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "preemptions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "recomputations": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "MoneyDto": {
        "type": "object",
        "description": "A monetary amount in a given ISO currency.",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "Patch": {
        "type": "object",
        "description": "A single JSON-patch-like edit that would resolve a diagnostic.",
        "required": [
          "op",
          "path",
          "value"
        ],
        "properties": {
          "op": {
            "type": "string",
            "description": "The patch operation (e.g. `replace`, `add`, `remove`)."
          },
          "path": {
            "type": "string",
            "description": "A JSON Pointer to the target location."
          },
          "value": {
            "type": "object",
            "description": "The value to apply."
          }
        }
      },
      "Plan": {
        "type": "object",
        "description": "A full plan: the set of actions Amicu would take, with the context needed\nto review them.",
        "required": [
          "version",
          "actions"
        ],
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlannedAction"
            },
            "description": "The planned actions, in application order."
          },
          "policy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PolicyOutcome",
                "description": "Aggregate policy outcome across all actions, if evaluated."
              }
            ]
          },
          "version": {
            "type": "string",
            "description": "Contract version. Currently always `\"v1\"`."
          }
        }
      },
      "PlanRequest": {
        "type": "object",
        "description": "Request body for `POST /plan`.",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "string",
            "description": "The Amicu HCL configuration text to plan."
          },
          "prior": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional prior-state config, as HCL, to diff against. When omitted the\nplan is computed against an empty prior (everything is a create)."
          }
        }
      },
      "PlannedAction": {
        "type": "object",
        "description": "A single planned change to one resource.",
        "required": [
          "kind",
          "address"
        ],
        "properties": {
          "address": {
            "type": "string",
            "description": "The target resource address (e.g. `deployment.support_chat_local`)."
          },
          "artifact": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Artifact",
                "description": "The selected artifact and its download characteristics."
              }
            ]
          },
          "cost_performance": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CostPerformance",
                "description": "Estimated cost and performance ranges with provenance."
              }
            ]
          },
          "hardware": {
            "type": [
              "string",
              "null"
            ],
            "description": "Target hardware descriptor (e.g. `gpu.a100_80gb`)."
          },
          "kind": {
            "$ref": "#/components/schemas/ActionKind",
            "description": "The kind of change."
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "description": "Target provider (e.g. `runpod`)."
          },
          "region": {
            "type": [
              "string",
              "null"
            ],
            "description": "Target region (e.g. `eu-central`)."
          },
          "required_action": {
            "type": [
              "string",
              "null"
            ],
            "description": "Manual action the user must take before this can be applied."
          },
          "required_secrets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names of secrets this action requires.\n\nThese are secret NAMES only. Secret values never appear in a plan."
          },
          "runtime": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Setting"
            },
            "description": "Runtime and material launch settings, as opaque key/value pairs."
          }
        }
      },
      "PolicyOutcome": {
        "type": "object",
        "description": "Governance / policy outcome for a plan.",
        "required": [
          "allowed"
        ],
        "properties": {
          "allowed": {
            "type": "boolean",
            "description": "Whether the plan is permitted under evaluated policy."
          },
          "denials": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Reasons the plan was denied, if `allowed` is false."
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Risks surfaced by policy evaluation."
          }
        }
      },
      "ProvenanceDto": {
        "type": "string",
        "description": "Where the evidence behind an estimate comes from. Mirrors\n[`amicu_core::estimate::Provenance`].",
        "enum": [
          "telemetry_aggregate",
          "public_benchmark",
          "provider_price",
          "formula"
        ]
      },
      "QueueMetricsDto": {
        "type": "object",
        "description": "Admission-queue surface.",
        "required": [
          "depth",
          "wait_ms",
          "admitted",
          "rejected"
        ],
        "properties": {
          "admitted": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "depth": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "rejected": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "wait_ms": {
            "$ref": "#/components/schemas/DistributionDto"
          }
        }
      },
      "Range": {
        "type": "object",
        "description": "An inclusive numeric range with an optional unit.",
        "required": [
          "min",
          "max"
        ],
        "properties": {
          "max": {
            "type": "number",
            "format": "double",
            "description": "Upper bound."
          },
          "min": {
            "type": "number",
            "format": "double",
            "description": "Lower bound."
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Unit label (e.g. `usd_per_hour`, `tokens_per_second`)."
          }
        }
      },
      "RecommendRequest": {
        "type": "object",
        "description": "Request body for `POST /recommend`: the measured metrics, the estimate they\nare judged against, and (optionally) custom rule thresholds.",
        "required": [
          "metrics",
          "estimate"
        ],
        "properties": {
          "estimate": {
            "$ref": "#/components/schemas/WorkloadEstimateDto",
            "description": "The workload estimate the metrics are compared against."
          },
          "metrics": {
            "$ref": "#/components/schemas/StackMetricsDto",
            "description": "The measured serving-metric surface for one stack (the same shape as\n`GET /stacks/:id/metrics`)."
          },
          "thresholds": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ThresholdsDto",
                "description": "Custom rule thresholds. Omit to use conservative defaults."
              }
            ]
          }
        }
      },
      "RecommendationDto": {
        "type": "object",
        "description": "An advisory, explainable tuning recommendation. `advisory` is always `true`.",
        "required": [
          "bottleneck",
          "summary",
          "changes",
          "evidence",
          "rejected",
          "confidence",
          "assumptions",
          "required_tier",
          "advisory"
        ],
        "properties": {
          "advisory": {
            "type": "boolean"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssumptionDto"
            }
          },
          "bottleneck": {
            "$ref": "#/components/schemas/BottleneckClassDto"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SuggestedChangeDto"
            }
          },
          "confidence": {
            "$ref": "#/components/schemas/ConfidenceDto"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceDto"
            }
          },
          "rejected": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RejectedAlternativeDto"
            }
          },
          "required_tier": {
            "$ref": "#/components/schemas/TierDto"
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "RecoverRequest": {
        "type": "object",
        "description": "A password-reset request (`POST /recover`).",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "The account email to send a reset link to."
          }
        }
      },
      "RecoverResponse": {
        "type": "object",
        "description": "The generic, anti-enumeration recover acknowledgement.",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "A message that reveals nothing about whether the email is registered."
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "description": "A refresh-token-bearing request (refresh rotation / logout).",
        "required": [
          "refresh_token"
        ],
        "properties": {
          "refresh_token": {
            "type": "string",
            "description": "The opaque refresh token previously issued to this client."
          }
        }
      },
      "RejectedAlternativeDto": {
        "type": "object",
        "description": "A change the engine considered and ruled out, with why.",
        "required": [
          "change",
          "reason"
        ],
        "properties": {
          "change": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "ReliabilityMetricsDto": {
        "type": "object",
        "description": "Reliability surface. Rates are fractions in `[0, 1]`.",
        "required": [
          "error_rate",
          "timeout_rate",
          "restarts"
        ],
        "properties": {
          "error_rate": {
            "type": "number",
            "format": "double"
          },
          "restarts": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "timeout_rate": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ResetRequest": {
        "type": "object",
        "description": "A password-reset completion (`POST /reset`): the opaque reset token plus the\nnew password to install.",
        "required": [
          "reset_token",
          "new_password"
        ],
        "properties": {
          "new_password": {
            "type": "string",
            "description": "The new account password (must satisfy the password policy)."
          },
          "reset_token": {
            "type": "string",
            "description": "The opaque reset token delivered out-of-band (e.g. via the reset link)."
          }
        }
      },
      "Setting": {
        "type": "object",
        "description": "An opaque runtime or launch setting.",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Setting key."
          },
          "value": {
            "type": "string",
            "description": "Setting value, rendered as a string."
          }
        }
      },
      "Severity": {
        "type": "string",
        "description": "Diagnostic severity level.",
        "enum": [
          "error",
          "warning",
          "info"
        ]
      },
      "SignUpResponse": {
        "type": "object",
        "description": "The generic, anti-enumeration sign-up acknowledgement.",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "A message that reveals nothing about whether the email already exists."
          }
        }
      },
      "SourceLocation": {
        "type": "object",
        "description": "The location in a source file a diagnostic refers to.",
        "required": [
          "file",
          "line",
          "column"
        ],
        "properties": {
          "column": {
            "type": "integer",
            "format": "int32",
            "description": "1-based column number.",
            "minimum": 0
          },
          "file": {
            "type": "string",
            "description": "Source file path."
          },
          "line": {
            "type": "integer",
            "format": "int32",
            "description": "1-based line number.",
            "minimum": 0
          }
        }
      },
      "StackMetricsDto": {
        "type": "object",
        "description": "The full measured metric surface for one stack over an observation window.",
        "required": [
          "deployment",
          "window_seconds",
          "latency",
          "throughput",
          "concurrency",
          "queue",
          "memory",
          "gpu",
          "cost",
          "reliability"
        ],
        "properties": {
          "concurrency": {
            "$ref": "#/components/schemas/ConcurrencyMetricsDto"
          },
          "cost": {
            "$ref": "#/components/schemas/CostMetricsDto"
          },
          "deployment": {
            "type": "string"
          },
          "gpu": {
            "$ref": "#/components/schemas/GpuMetricsDto"
          },
          "latency": {
            "$ref": "#/components/schemas/LatencyMetricsDto"
          },
          "memory": {
            "$ref": "#/components/schemas/MemoryKvMetricsDto"
          },
          "queue": {
            "$ref": "#/components/schemas/QueueMetricsDto"
          },
          "reliability": {
            "$ref": "#/components/schemas/ReliabilityMetricsDto"
          },
          "throughput": {
            "$ref": "#/components/schemas/ThroughputMetricsDto"
          },
          "window_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "SuggestedChangeDto": {
        "type": "object",
        "description": "A described (never applied) tuning change.",
        "required": [
          "action",
          "direction",
          "detail"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "direction": {
            "$ref": "#/components/schemas/ChangeDirectionDto"
          }
        }
      },
      "SuggestedFix": {
        "type": "object",
        "description": "A suggested fix attached to a diagnostic.",
        "required": [
          "description",
          "patch"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "Human-readable description of the fix."
          },
          "patch": {
            "$ref": "#/components/schemas/Patch",
            "description": "The proposed patch."
          }
        }
      },
      "ThresholdsDto": {
        "type": "object",
        "description": "Rule trigger points. Any omitted field falls back to the engine default.",
        "required": [
          "gpu_util_high",
          "gpu_util_low",
          "queue_wait_p99_ms",
          "kv_utilization_high",
          "ttft_p90_ms",
          "tpot_p90_ms"
        ],
        "properties": {
          "gpu_util_high": {
            "type": "number",
            "format": "double"
          },
          "gpu_util_low": {
            "type": "number",
            "format": "double"
          },
          "kv_utilization_high": {
            "type": "number",
            "format": "double"
          },
          "queue_wait_p99_ms": {
            "type": "number",
            "format": "double"
          },
          "tpot_p90_ms": {
            "type": "number",
            "format": "double"
          },
          "ttft_p90_ms": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ThroughputMetricsDto": {
        "type": "object",
        "description": "Throughput surface.",
        "required": [
          "output_tokens_per_s",
          "prompt_tokens_per_s",
          "requests_per_s"
        ],
        "properties": {
          "output_tokens_per_s": {
            "type": "number",
            "format": "double"
          },
          "prompt_tokens_per_s": {
            "type": "number",
            "format": "double"
          },
          "requests_per_s": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "TierDto": {
        "type": "string",
        "description": "Product tier that unlocks a recommendation. Mirrors\n[`amicu_recommend::Tier`].",
        "enum": [
          "community",
          "pro",
          "enterprise",
          "hosted_cloud"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "description": "An issued access + refresh token pair.",
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Short-lived access JWT (verify offline via JWKS)."
          },
          "expires_in": {
            "type": "integer",
            "format": "int64",
            "description": "Access-token lifetime, seconds."
          },
          "refresh_token": {
            "type": "string",
            "description": "Opaque, rotating refresh token."
          },
          "token_type": {
            "type": "string",
            "description": "Always `Bearer`."
          }
        }
      },
      "TuningReportDto": {
        "type": "object",
        "description": "A diagnosis for one stack: its advisory recommendations, tier-appropriate.",
        "required": [
          "deployment",
          "recommendations"
        ],
        "properties": {
          "deployment": {
            "type": "string"
          },
          "recommendations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecommendationDto"
            },
            "description": "Recommendations in severity order; the first is the primary diagnosis.\nEmpty for a caller whose tier unlocks none of them."
          }
        }
      },
      "ValidateRequest": {
        "type": "object",
        "description": "Request body for `POST /validate`.",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "string",
            "description": "The Amicu HCL configuration text to validate."
          }
        }
      },
      "WorkloadEstimateDto": {
        "type": "object",
        "description": "Expected serving behavior and the assumptions behind it.",
        "required": [
          "assumed_prompt_tokens",
          "assumed_generation_tokens",
          "assumed_concurrency",
          "expected_ttft_ms",
          "expected_tpot_ms"
        ],
        "properties": {
          "assumed_concurrency": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "assumed_generation_tokens": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "assumed_prompt_tokens": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "expected_tpot_ms": {
            "$ref": "#/components/schemas/EstimateRangeDto"
          },
          "expected_ttft_ms": {
            "$ref": "#/components/schemas/EstimateRangeDto"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Sign-up, token issuance/rotation, logout, and JWKS discovery."
    },
    {
      "name": "engine",
      "description": "Stateless, side-effect-free validate and plan endpoints (auth-gated)."
    },
    {
      "name": "recommend",
      "description": "Stateless advisory tuning recommendations from a metrics + estimate snapshot (auth-gated, tier-appropriate)."
    }
  ]
}
