{
  "name": "@amicu/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "gen:facts": "node scripts/gen-site-facts.mjs",
    "lint:links": "tsx scripts/lint-links.ts",
    "test": "node --test --experimental-strip-types 'lib/**/*.test.ts' && node --conditions=react-server --import tsx --test test/workerd/cookie-refresh.unit.test.ts test/workerd/signin-disabled.unit.test.ts",
    "test:workerd-live": "node --conditions=react-server --import tsx --test test/workerd/live-preview.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build && pnpm cf:upload-assets",
    "cf:upload-assets": "opennextjs-cloudflare populateCache local",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@amicu/api-client": "workspace:*",
    "@amicu/auth": "workspace:*",
    "@amicu/ui": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.13",
    "@sentry/nextjs": "^11.7.0",
    "fumadocs-core": "16.14.5",
    "fumadocs-mdx": "15.3.0",
    "fumadocs-ui": "16.14.5",
    "lucide-react": "^1.33.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.438.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@amicu/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "next-validate-link": "^1.6.7",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.148.0"
  }
}
