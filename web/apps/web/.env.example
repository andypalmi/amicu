# Amicu web - server-only auth/BFF configuration.
# Copy to `.env.local` for local development. None of these are exposed to the
# browser (no NEXT_PUBLIC_*): the browser talks only to the BFF.

# Base URL of the Rust Management API / TASK-078 auth issuer.
API_URL=http://localhost:8080

# Public site origin (build-time). Production: https://amicu.dev; the API is
# https://api.amicu.dev (API_URL, and the default AUTH_ISSUER). Unset => dev
# falls back to http://localhost:3000, production builds to https://amicu.dev.
# Turnstile's expected hostname is derived from this; when it is unset the
# Turnstile hostname check is skipped (amicu.dev is NOT enforced).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional overrides (defaults are derived from API_URL):
# AUTH_JWKS_URL=http://localhost:8080/.well-known/jwks.json
# AUTH_ISSUER=http://localhost:8080   (production: https://api.amicu.dev)
# AUTH_AUDIENCE=amicu

# Public sign-ups are CLOSED unless this is exactly "true" (fail-closed). Set it
# for local dev; also set AMICU_SIGNUPS_ENABLED=true on the API, which enforces it.
SIGNUPS_ENABLED=true
