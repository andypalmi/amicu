{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name shown in the Cloudflare dashboard / `wrangler deploy` output.
  // Rename to match the account's chosen Workers service name before deploying.
  "name": "amicu-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    // Required by @opennextjs/cloudflare: Next.js server code uses Node.js
    // builtins (streams, async_hooks, etc.) that only exist under this flag.
    "nodejs_compat",
    // Restricts `fetch()` from Worker code to public internet addresses only
    // (blocks e.g. internal metadata endpoints) - recommended by the OpenNext
    // Cloudflare get-started guide.
    "global_fetch_strictly_public",
    // amicu's lib/auth/config.ts reads `process.env.API_URL` etc. at MODULE
    // EVALUATION time (not inside a request handler), so it can read the
    // fail-fast config before the first request auth check runs. That keeps
    // working under OpenNext NOT because of this flag (`allow_importable_env`
    // is just the explicit spelling of the Workers default - it only matters
    // paired with its opposite, `disallow_importable_env`, which we don't
    // set), but because @opennextjs/cloudflare calls its own
    // `populateProcessEnv()` per request, copying the `env` bindings onto
    // `process.env` before the Next.js server code (including cached
    // module-level reads from a prior request in the same isolate) runs.
    // That population is itself gated by the separate
    // `nodejs_compat_populate_process_env` flag, which is default-ON for any
    // `compatibility_date` after 2025-04-01 (ours is well past that). Kept
    // here for explicitness even though it's currently a no-op. See
    // README-deploy-cloudflare.md.
    "allow_importable_env",
  ],
  // Production custom domain: the zone amicu.dev is on this Cloudflare account,
  // so `wrangler deploy` attaches the Worker to the apex and manages its DNS
  // record + certificate. www.amicu.dev -> apex redirect is handled by infra.
  // The API lives separately on https://api.amicu.dev (Cloud Run). Local
  // `wrangler dev` / `cf:preview` ignore routes, so previews are unaffected.
  "routes": [{ "pattern": "amicu.dev", "custom_domain": true }],
  "assets": {
    // OpenNext's static build output (Next.js public/ + prerendered assets).
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // PLACEHOLDER values only - none of these are secrets, but none of these
  // are real either. Real deploys must override every one of them via
  // Cloudflare dashboard "Variables and Secrets" (or `wrangler secret put` /
  // an environment-specific `vars` block) - never commit real values here.
  // See README-deploy-cloudflare.md for the full table and the hard rule
  // that AUTH_ISSUER/AUTH_AUDIENCE MUST match the API's
  // AMICU_ISSUER/AMICU_AUDIENCE.
  "vars": {
    "API_URL": "https://REPLACE-ME.example.invalid",
    "AUTH_ISSUER": "https://REPLACE-ME.example.invalid",
    "AUTH_AUDIENCE": "amicu",
    "AUTH_JWKS_URL": "https://REPLACE-ME.example.invalid/.well-known/jwks.json",
    "NEXT_PUBLIC_SITE_URL": "https://REPLACE-ME.example.invalid",
    "NODE_ENV": "production",
  },
  // Turnstile (optional; omitted => widget hidden, verification skipped):
  //  - NEXT_PUBLIC_TURNSTILE_SITE_KEY: public; BUILD-time (set before cf:build).
  //  - TURNSTILE_SECRET_KEY: SECRET, server-only. Set with
  //    `wrangler secret put TURNSTILE_SECRET_KEY`; never add it to "vars".
  "observability": {
    "enabled": true,
  },
}
