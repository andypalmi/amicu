{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name shown in the Cloudflare dashboard / `wrangler deploy` output.
  // Rename to match the account's chosen Workers service name before deploying.
  "name": "amicu-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    // Required by @opennextjs/cloudflare: Next.js server code uses Node.js
    // builtins (streams, async_hooks, etc.) that only exist under this flag.
    "nodejs_compat",
    // Restricts `fetch()` from Worker code to public internet addresses only
    // (blocks e.g. internal metadata endpoints) - recommended by the OpenNext
    // Cloudflare get-started guide.
    "global_fetch_strictly_public",
    // amicu's lib/auth/config.ts reads `process.env.API_URL` etc. at MODULE
    // EVALUATION time (not inside a request handler), so it can read the
    // fail-fast config before the first request auth check runs. Cloudflare
    // Workers normally only populate `process.env` once a request context
    // exists; this flag makes `vars`/secrets importable at module-eval time
    // too, so that pattern keeps working unmodified under OpenNext. See
    // README-deploy-cloudflare.md.
    "allow_importable_env",
  ],
  "assets": {
    // OpenNext's static build output (Next.js public/ + prerendered assets).
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // PLACEHOLDER values only - none of these are secrets, but none of these
  // are real either. Real deploys must override every one of them via
  // Cloudflare dashboard "Variables and Secrets" (or `wrangler secret put` /
  // an environment-specific `vars` block) - never commit real values here.
  // See README-deploy-cloudflare.md for the full table and the hard rule
  // that AUTH_ISSUER/AUTH_AUDIENCE MUST match the API's
  // AMICU_ISSUER/AMICU_AUDIENCE.
  "vars": {
    "API_URL": "https://REPLACE-ME.example.invalid",
    "AUTH_ISSUER": "https://REPLACE-ME.example.invalid",
    "AUTH_AUDIENCE": "amicu",
    "AUTH_JWKS_URL": "https://REPLACE-ME.example.invalid/.well-known/jwks.json",
    "NEXT_PUBLIC_SITE_URL": "https://REPLACE-ME.example.invalid",
    "NODE_ENV": "production",
  },
  "observability": {
    "enabled": true,
  },
}
