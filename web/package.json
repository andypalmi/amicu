{
  "name": "amicu-web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:links": "pnpm --filter @amicu/web lint:links",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:generated": "turbo run check:generated",
    "clean": "turbo run clean",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "turbo": "2.10.11",
    "typescript": "^6.0.3"
  }
}
