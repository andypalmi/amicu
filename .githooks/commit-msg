#!/bin/sh
# Block Claude / Claude Code attribution in commit messages. Offending lines
# are stripped from the message file so it can be re-committed as-is.
dir=$(dirname "$0")
removed=$("$dir/no-claude-attribution.sh" strip "$1" 2>&1)
if [ $? -ne 0 ]; then
  echo "commit-msg: commit blocked, Claude attribution is not allowed in commit messages." >&2
  echo "Removed these lines from the message:" >&2
  printf '%s\n' "$removed" >&2
  echo "The cleaned message is in .git/COMMIT_EDITMSG. Re-commit with:" >&2
  echo "  git commit -F .git/COMMIT_EDITMSG    (or: git commit -e -F .git/COMMIT_EDITMSG)" >&2
  exit 1
fi

# Then chain to the clone-local commit-msg hook (core.hooksPath replaces .git/hooks).
common=$(git rev-parse --git-common-dir 2>/dev/null)
if [ -n "$common" ] && [ -x "$common/hooks/commit-msg" ]; then
  "$common/hooks/commit-msg" "$@" || exit $?
fi
exit 0
